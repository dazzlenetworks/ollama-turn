<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>OllamaTurn</RootNamespace>
    <AssemblyName>OllamaTurn</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- cli\ is its own project (OllamaTurnCLI); don't sweep it in here.
         shared\ is picked up by the default glob and compiled into both. -->
    <Compile Remove="cli\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the web UI next to the exe -->
    <None Update="www\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- No config.json is copied: the app falls back to its built-in default and
         writes the file beside the exe on first save. config.example.json only
         documents the file's shape, so a build or publish can never overwrite a
         configured copy. -->
  </ItemGroup>

  <!-- Builds before this file stopped copying config.json listed it as one of
       their outputs, and MSBuild's incremental clean deletes a listed output the
       current build no longer produces - which would take a configured copy with
       it. Declaring it here keeps it on the list without writing it. This has to
       run before _CleanGetCurrentAndPriorFileWrites, which takes the list;
       hooking IncrementalClean itself is too late. dotnet clean still deletes it,
       as it always has. -->
  <Target Name="KeepRuntimeConfig" BeforeTargets="_CleanGetCurrentAndPriorFileWrites">
    <ItemGroup>
      <FileWrites Include="$(OutDir)config.json" />
    </ItemGroup>
  </Target>

</Project>
